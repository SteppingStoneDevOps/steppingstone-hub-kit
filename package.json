{
  "name": "@steppingstone/hub-kit",
  "version": "0.17.0",
  "description": "Shared design-system primitives for the SteppingStone hubs (advisor-hub, admin-hub, talent-hub). Single source of truth for the UI kit \u2014 consumed as source via transpilePackages + @source.",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "lucide-react": ">=1.0.0",
    "next": ">=16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.24.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
